{
 "segments": [
  {
   "start": 0.0,
   "end": 2.7,
   "text": "So someone built an entire AI agency and open-sourced it."
  },
  {
   "start": 2.76,
   "end": 5.6,
   "text": "It's called The Agency, with over 124,000 stars on GitHub."
  },
  {
   "start": 5.82,
   "end": 9.16,
   "text": "So this has a full roster of specialist agents, front-end designers, ad writers,"
  },
  {
   "start": 9.32,
   "end": 11.92,
   "text": "Reddit community wizards, each with its own personality and process."
  },
  {
   "start": 12.2,
   "end": 15.66,
   "text": "It plugs straight into cloud code and there's even a desktop app that installs your dream team"
  },
  {
   "start": 15.66,
   "end": 18.34,
   "text": "in one click. You just became an AI agency owner for free."
  },
  {
   "start": 18.44,
   "end": 19.92,
   "text": "Call an agency and I'll send you the repo."
  }
 ],
