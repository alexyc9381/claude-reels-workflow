{
 "segments": [
  {
   "start": 1.4,
   "end": 4.34,
   "text": "So someone built an entire AI agency and open sourced it."
  },
  {
   "start": 4.4,
   "end": 7.24,
   "text": "It's called The Agency, with over 124,000 stars on GitHub."
  },
  {
   "start": 7.9,
   "end": 11.74,
   "text": "So this has a full roster of specialist agents, front-end designers, ad writers, Reddit community"
  },
  {
   "start": 11.74,
   "end": 14.02,
   "text": "wizards, each with its own personality and process."
  },
  {
   "start": 15.52,
   "end": 18.86,
   "text": "It plugs straight into cloud code and there's even a desktop app that installs your dream"
  },
  {
   "start": 18.86,
   "end": 19.66,
   "text": "team in one click."
  },
  {
   "start": 19.84,
   "end": 21.72,
   "text": "You just became an AI agency owner for free."
  },
  {
   "start": 21.72,
   "end": 23.34,
   "text": "Call an agency and I'll send you the repo."
  }
 ],
