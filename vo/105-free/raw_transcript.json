  },
  {
   "start": 28.08,
   "end": 29.3,
   "text": "Just drop down a prompt, cut, cut."
  },
  {
   "start": 29.3,
   "end": 31.56,
   "text": "Just drop in a prompt and get a video on the spot."
  },
  {
   "start": 31.96,
   "end": 32.28,
   "text": "Number 3."
  },
  {
   "start": 32.46,
   "end": 33.16,
   "text": "A free cut, cut."
  },
  {
   "start": 33.62,
   "end": 33.92,
   "text": "Number 3."
  },
  {
